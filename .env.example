# Supabase → Project → Connect → "Session pooler" → URI (works on IPv4 networks)
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Auth (login): Project Settings → API Keys.
# Use the publishable key only; never put the secret key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, default :8080
# ADDR=:8080
